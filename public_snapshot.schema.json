{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watchjoeylosemoney.com/public_snapshot.schema.json",
  "title": "WatchJoeyLoseMoney public snapshot",
  "$defs": {
    "latency_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "median_ms", "p95_ms", "p99_ms"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "median_ms": { "type": ["number", "null"], "minimum": 0 },
        "p95_ms": { "type": ["number", "null"], "minimum": 0 },
        "p99_ms": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "data_as_of_utc",
    "publication_delay_minutes",
    "mode",
    "status",
    "stats",
    "execution_telemetry",
    "latency_health",
    "reliability",
    "guardian_transitions",
    "equity_curve",
    "latest_trades"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "data_as_of_utc": { "type": "string", "format": "date-time" },
    "publication_delay_minutes": { "type": "integer", "minimum": 0 },
    "mode": { "enum": ["SHADOW", "DEMO", "LIVE", "PAUSED", "FAULT", "OFFLINE"] },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_state", "guardian_state", "market_data_state", "execution_enabled", "data_delayed", "message"],
      "properties": {
        "service_state": { "enum": ["STARTING", "REPLAYING", "ARMED", "PAUSED", "FAULT", "OFFLINE"] },
        "guardian_state": { "enum": ["ARMED", "DISARMED", "FAULT", "NA"] },
        "market_data_state": { "enum": ["LIVE", "REPLAY", "STALE", "GAPPED", "DISCONNECTED", "UNKNOWN"] },
        "execution_enabled": { "type": "boolean" },
        "data_delayed": { "type": "boolean" },
        "message": { "type": "string" }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_starting_equity_usd", "display_equity_usd",
        "realized_pnl_today_usd", "realized_pnl_all_time_usd",
        "current_drawdown_usd", "max_drawdown_usd",
        "closed_trades_today", "closed_trades_all_time",
        "wins", "losses", "breakeven",
        "win_rate", "expectancy_usd", "profit_factor"
      ],
      "properties": {
        "display_starting_equity_usd": { "type": "number" },
        "display_equity_usd": { "type": "number" },
        "realized_pnl_today_usd": { "type": "number" },
        "realized_pnl_all_time_usd": { "type": "number" },
        "current_drawdown_usd": { "type": "number", "minimum": 0 },
        "max_drawdown_usd": { "type": "number", "minimum": 0 },
        "closed_trades_today": { "type": "integer", "minimum": 0 },
        "closed_trades_all_time": { "type": "integer", "minimum": 0 },
        "wins": { "type": "integer", "minimum": 0 },
        "losses": { "type": "integer", "minimum": 0 },
        "breakeven": { "type": "integer", "minimum": 0 },
        "win_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "expectancy_usd": { "type": ["number", "null"] },
        "profit_factor": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "execution_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_size", "submit_to_ack_ms_median", "submit_to_ack_ms_p95",
        "submit_to_fill_ms_median", "submit_to_fill_ms_p95",
        "slippage_ticks_mean", "slippage_ticks_p95", "slippage_usd_mean"
      ],
      "properties": {
        "sample_size": { "type": "integer", "minimum": 0 },
        "submit_to_ack_ms_median": { "type": ["number", "null"] },
        "submit_to_ack_ms_p95": { "type": ["number", "null"] },
        "submit_to_fill_ms_median": { "type": ["number", "null"] },
        "submit_to_fill_ms_p95": { "type": ["number", "null"] },
        "slippage_ticks_mean": { "type": ["number", "null"] },
        "slippage_ticks_p95": { "type": ["number", "null"] },
        "slippage_usd_mean": { "type": ["number", "null"] }
      }
    },
    "latency_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bars_sampled", "stalls_over_750ms", "stalls_over_2s", "cpu_median_pct", "load1_median", "verdict", "stages"],
      "properties": {
        "bars_sampled": { "type": "integer", "minimum": 0 },
        "stalls_over_750ms": { "type": "integer", "minimum": 0 },
        "stalls_over_2s": { "type": "integer", "minimum": 0 },
        "cpu_median_pct": { "type": ["number", "null"], "minimum": 0 },
        "load1_median": { "type": ["number", "null"], "minimum": 0 },
        "verdict": { "enum": ["HEALTHY", "MARGINAL", "NEEDS_UPGRADE", "INSUFFICIENT_DATA"] },
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queue_wait_ms", "ingest_and_decision_ms", "get_account_http_ms",
            "submit_order_ms", "poll_until_filled_ms", "post_entry_reconciliation_ms",
            "total_bar_to_submit_ms"
          ],
          "properties": {
            "queue_wait_ms": { "$ref": "#/$defs/latency_stage" },
            "ingest_and_decision_ms": { "$ref": "#/$defs/latency_stage" },
            "get_account_http_ms": { "$ref": "#/$defs/latency_stage" },
            "submit_order_ms": { "$ref": "#/$defs/latency_stage" },
            "poll_until_filled_ms": { "$ref": "#/$defs/latency_stage" },
            "post_entry_reconciliation_ms": { "$ref": "#/$defs/latency_stage" },
            "total_bar_to_submit_ms": { "$ref": "#/$defs/latency_stage" }
          }
        }
      }
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restart_count", "first_started_at_utc", "last_started_at_utc", "crash_report_count"],
      "properties": {
        "restart_count": { "type": ["integer", "null"], "minimum": 0 },
        "first_started_at_utc": { "type": ["string", "null"], "format": "date-time" },
        "last_started_at_utc": { "type": ["string", "null"], "format": "date-time" },
        "crash_report_count": { "type": "integer", "minimum": 0 }
      }
    },
    "guardian_transitions": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ts_utc", "from_state", "to_state", "reason"],
        "properties": {
          "ts_utc": { "type": "string", "format": "date-time" },
          "from_state": {
            "enum": ["BOOT", "RECONCILING", "WARMUP", "ARMED", "IN_POSITION", "EXIT_PENDING", "VERIFY_FLAT", "LOCKED", "EMERGENCY"]
          },
          "to_state": {
            "enum": ["BOOT", "RECONCILING", "WARMUP", "ARMED", "IN_POSITION", "EXIT_PENDING", "VERIFY_FLAT", "LOCKED", "EMERGENCY"]
          },
          "reason": { "type": "string" }
        }
      }
    },
    "equity_curve": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ts_utc", "equity_usd", "cum_pnl_usd", "drawdown_usd"],
        "properties": {
          "ts_utc": { "type": "string", "format": "date-time" },
          "equity_usd": { "type": "number" },
          "cum_pnl_usd": { "type": "number" },
          "drawdown_usd": { "type": "number", "minimum": 0 }
        }
      }
    },
    "latest_trades": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "closed_at_utc", "session_date", "side", "pnl_usd", "exit_reason", "duration_seconds", "mode",
          "entry_rss_mb", "entry_process_cpu_pct", "entry_host_cpu_user_pct", "entry_host_load1",
          "expected_net_pnl_model_usd"
        ],
        "properties": {
          "closed_at_utc": { "type": "string", "format": "date-time" },
          "session_date": { "type": "string", "format": "date" },
          "side": { "enum": ["LONG", "SHORT"] },
          "pnl_usd": { "type": "number" },
          "exit_reason": { "type": "string" },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "mode": { "enum": ["SHADOW", "DEMO", "LIVE"] },
          "entry_rss_mb": { "type": ["number", "null"], "minimum": 0 },
          "entry_process_cpu_pct": { "type": ["number", "null"] },
          "entry_host_cpu_user_pct": { "type": ["number", "null"] },
          "entry_host_load1": { "type": ["number", "null"], "minimum": 0 },
          "expected_net_pnl_model_usd": { "type": ["number", "null"] }
        }
      }
    }
  }
}
